# Supabase project (Settings → API). Without these the site still runs on sample data:
# hearts, notes and checklists stay in localStorage, and phone sign-in runs in demo mode
# (any 6-digit code works).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Show the bottom-left seasonal theme debug panel on every page.
# It also appears on any URL with ?debug.
VITE_SHOW_THEME_DEBUG=false

# Seasonal particles: off | subtle (default, behind the home hero) | festive (whole page)
VITE_SEASONAL_FX=subtle
